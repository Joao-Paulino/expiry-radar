  "public_url": "https://radar.example.com:8443",
  "theme": "dark",

  "agents": [
    { "id": "web-01", "token": "3f8a1c0d9e2b47a6b5c4d3e2f1a0b9c8d7e6f5a4b3c2d1e0f9a8b7c6d5e4f3a2" },
